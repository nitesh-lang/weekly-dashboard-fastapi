__pycache__/
*.pyc

# Auth — never commit user credentials or session secrets
data/users.json
.env
.env.local

# Phase 1 ingestion — local-only output, never commit
data/raw_phase1/
scripts/ingest_phase1/.env

# Frontend build artifacts — regenerated by `npm run build` on Render
frontend/node_modules/
frontend/dist/
frontend/.vite/

# SPA bundle — regenerated by the Render build step (npm run build)
weekly_app/static/spa/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Excel lock files (created when a workbook is open in Excel)
~$*

# Local backups (fix_inventory_model_casing.py drops a .bak next to
# each modified workbook before writing).
*.bak
