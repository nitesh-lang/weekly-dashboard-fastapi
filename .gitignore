__pycache__/
*.pyc

# Auth — never commit user credentials or session secrets
data/users.json
.env
.env.local

# Phase 1 ingestion — local-only output, never commit
data/raw_phase1/
scripts/ingest_phase1/.env

# Frontend build artifacts — regenerated by `npm run build` on Render
frontend/node_modules/
frontend/dist/
frontend/.vite/

# SPA bundle — regenerated by the Render build step (npm run build)
weekly_app/static/spa/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Excel lock files (created when a workbook is open in Excel)
~$*

# Local backups (fix_inventory_model_casing.py drops a .bak next to
# each modified workbook before writing).
*.bak
*.bak.*

# Ads Reports API intermediates — re-derivable from .ads_reports_state.json
# OR by re-running the API pull.  Never commit; canonical merged data lives
# in ads_report_weekN.xlsx (without the _api suffix).
data/ams_weekly_data/*/ads_report_week*_api.xlsx

# Ads Reports state file — contains short-lived report IDs / signed S3
# URLs that expire in ~1 hour, plus credentials hints in failure strings.
data/processed/.ads_reports_state.json

# SP-API seller pulls — per-account TSV/CSV intermediates merged into
# the canonical per-brand "Seller Sales (SP-API).xlsx" / "Seller FBA
# Inventory (SP-API).xlsx".  Keep the canonical xlsx, not the raw merge.
data/raw/sales/**/_seller_sp_api/
data/raw/inventory/**/_seller_sp_api/

# Ads change-history probe artifacts — investigation output, never commit
# (workflow uploads them as run artifacts instead).
scripts/_audit/
local.db

# Vendored sub-project build state — Render builds these on every deploy
sales_dash_frontend/node_modules/
sales_dash_frontend/dist/
buybox_src/node_modules/
buybox_src/dist/
buybox_src/public/data.enc
