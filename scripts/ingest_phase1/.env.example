# ============================================================
# Phase 1 Ads ingestion — local credentials only.
# Copy this file to .env in the SAME folder (scripts/ingest_phase1/.env)
# and fill in each value. .env is gitignored — won't be committed.
# Never put production secrets in this file if you're on a shared
# machine — these tokens have broad scope.
# ============================================================

# ── Ads API LWA app (one app, multiple seller authorizations)
# Get these from Amazon's Login with Amazon → Security Profile
ADS_API_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxx
ADS_API_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Refresh token from ordersamazon06@gmail.com (the Ads-API operator account)
# Long-lived; one token covers all 4 ad profiles below.
ADS_API_REFRESH_TOKEN=Atzr|IwEBI...long string...

# ── Profile IDs (one per ad account — all four must be separate variables)
# If you don't know these, run: python -m scripts.ingest_phase1.run_ads --list-profiles
# It uses the credentials above to list every profile your token can access.
ADS_PROFILE_NEXLEV=
ADS_PROFILE_AUDIOARRAY=
ADS_PROFILE_WHITEMULBERRY=
ADS_PROFILE_CAMBIUM=

# ── Region (default India)
# Valid values: IN, EU, NA, FE.
# India profiles are served by the EU regional endpoint
# (advertising-api-eu.amazon.com) — there is no separate .in host.
# IN and EU both resolve to the same endpoint here.
ADS_API_REGION=IN
